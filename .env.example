# Same-origin path the browser calls, so it can read and echo the CSRF cookie.
# Environment-independent — the backend host lives in API_PROXY_TARGET below.
VITE_API_BASE_URL=/powerhub/v1/api

# Backend this environment proxies to. Required: the build fails without it.
# Drives both the Vite dev/preview proxy and the generated Netlify _redirects.
# On Netlify set it as a build environment variable, scoped per deploy context.
API_PROXY_TARGET=https://sbctest.memmserve.com
